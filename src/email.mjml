<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" color="#003b7a" />
      <mj-text font-size="16px" line-height="1.35" />
      <mj-button background-color="#003b7a" color="#ffffff" font-size="20px" font-weight="700" inner-padding="18px 24px" />
    </mj-attributes>
    <mj-style inline="inline">
      .email-link { color: #003b7a !important; text-decoration: none !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff" width="600px">
    <mj-section background-color="#1175b9" padding="4px 0 0">
      <mj-column padding="0" />
    </mj-section>

    <mj-include path="sections/hero.mjml" />
  </mj-body>
</mjml>
