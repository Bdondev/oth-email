<mj-section background-color="#ffffff" padding="72px 24px 0">
  <mj-column>
    <mj-text
      align="center"
      font-family="Georgia, 'Times New Roman', serif"
      font-size="58px"
      line-height="1"
      letter-spacing="-3px"
      padding="0 0 88px"
      color="#003b7a"
    >off the hook</mj-text>

    <mj-text
      align="center"
      font-size="56px"
      line-height="1.08"
      font-weight="700"
      letter-spacing="1px"
      padding="0 0 64px"
      color="#003b7a"
    >THE<br />RETURN OF<br />THE<br />JUMPMAN</mj-text>

    <mj-image
      src="{{HERO_IMAGE_URL}}"
      alt="Jordan sneakers arranged together"
      width="504px"
      padding="0"
    />
  </mj-column>
</mj-section>
