<mj-section background-color="#ffffff" padding="84px 24px 0">
  <mj-column>
    <mj-text
      align="center"
      color="#003b7a"
      font-size="56px"
      line-height="1.08"
      font-weight="700"
      letter-spacing="1px"
      padding="0 0 34px"
    >UPCOMING<br />JORDAN<br />DROPS</mj-text>

    <mj-text
      align="center"
      color="#003b7a"
      font-size="24px"
      line-height="1.2"
      font-weight="700"
      padding="0 12px 64px"
    >IN-STORE AT 11:00 AM,<br />ONLINE &amp; IN-APP AT 2:00<br />PM ON WEDNESDAY,<br />OCTOBER 11</mj-text>
  </mj-column>
</mj-section>

